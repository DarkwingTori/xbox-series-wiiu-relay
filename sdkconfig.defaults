# Dual-mode Bluetooth: Classic BT (for the Wii U HID peripheral side) and
# BLE (for the Xbox Series controller central side) at the same time.
# Exact Kconfig symbol names shift between ESP-IDF versions - if `idf.py
# build` complains these don't exist, open `idf.py menuconfig` and find the
# renamed equivalents under Component config -> Bluetooth. The settings that
# matter: controller mode = BTDM (both radios), Bluedroid enabled, Classic
# BT HID Device profile enabled, GATT Client enabled, Classic BT Secure
# Simple Pairing DISABLED (see main/hid_peripheral.c for why).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_SSP_ENABLED=n
